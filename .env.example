# Copy to .env (never commit .env). All values are optional.

# Where meetings, settings and models are stored.
# Default: ~/Documents/AIMeetingNotes  — use ./data while developing.
MEETING_NOTES_DATA_DIR=./data

# Gemini API key from https://aistudio.google.com/apikey (provider "gemini_api").
# Not needed if you use the Gemini CLI signed in with your Google AI plan (provider "gemini_cli").
GEMINI_API_KEY=

# Claude Code needs no key here: it uses the account `claude` is signed in with.
